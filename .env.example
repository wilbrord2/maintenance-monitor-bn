# ---------------------------------------------------------------------------
# Maintenance Monitor API — environment configuration
# Copy to .env and replace every placeholder. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Express "trust proxy" setting: false | true | <hop count> | <subnet list>
TRUST_PROXY=false
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
BODY_SIZE_LIMIT=100kb

# --- Database ---------------------------------------------------------------
# Used when running the API directly (npm run dev / npm start).
# docker compose builds DATABASE_URL from the POSTGRES_* values below instead.
# Use a database dedicated to this application (migrations create users, machines, ... tables).
DATABASE_URL=postgres://maintenance:change-me@localhost:5432/maintenance_monitor
# Alternatively, leave DATABASE_URL unset and provide the parts (credentials are URL-encoded for you):
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=maintenance
# DATABASE_PASSWORD=change-me
# DATABASE_NAME=maintenance_monitor
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_LOGGING=false

# --- JWT --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=maintenance-monitor
JWT_AUDIENCE=maintenance-monitor-clients

# Refresh token cookie (httpOnly, SameSite=Strict, path /api/v1/auth)
REFRESH_COOKIE_NAME=mm_refresh_token
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true

# --- Password hashing (Argon2id) ---------------------------------------------
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Authentication policy ---------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TEMP_PASSWORD_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30
# Frontend page that receives ?token=... from the reset email
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Frontend login page linked from onboarding emails
APP_LOGIN_URL=http://localhost:5173/login

# --- Company email (SMTP) ----------------------------------------------------
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=465, MAIL_SECURE=true, MAIL_USERNAME=<gmail address>,
#        MAIL_PASSWORD=<16-character App Password, no spaces>, MAIL_FROM=<same gmail address>
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# true for implicit TLS (port 465); false uses STARTTLS when offered
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=maintenance@example.com
MAIL_FROM_NAME=Maintenance Monitor

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
FORGOT_PASSWORD_RATE_LIMIT_MAX=5

# --- Swagger / OpenAPI -----------------------------------------------------------
# Enabled by default outside production. In production it requires basic-auth credentials.
# SWAGGER_ENABLED=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# --- Docker Compose -------------------------------------------------------------
POSTGRES_DB=maintenance_monitor
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=change-me-to-a-strong-password
API_PORT=3000
# With `docker compose --profile mail up -d mailpit`, set MAIL_HOST=mailpit and MAIL_PORT=1025.

# --- Seed (initial ADMIN account; used only by `npm run seed`) -----------------
# ADMIN_PASSWORD must be 12+ characters with upper, lower case and a digit.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
ADMIN_PHONE=0780000000
