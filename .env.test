# Test-only configuration (non-secret values). Loaded by the Jest integration project.
# Override DATABASE_URL in the shell to point at a different disposable database.
NODE_ENV=test
LOG_LEVEL=silent
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://localhost:5432/maintenance_monitor_test
JWT_ACCESS_SECRET=test-access-secret-0123456789abcdefghijklmnopqrstuvwxyz
JWT_REFRESH_SECRET=test-refresh-secret-0123456789abcdefghijklmnopqrstuvwxyz
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ARGON2_MEMORY_COST=4096
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_URL=http://localhost:5173/reset-password
APP_LOGIN_URL=http://localhost:5173/login
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=maintenance@example.test
RATE_LIMIT_MAX=100000
AUTH_RATE_LIMIT_MAX=100000
FORGOT_PASSWORD_RATE_LIMIT_MAX=100000
SWAGGER_ENABLED=true
